{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": ["vite.config.js", "vite.config.ts"]
}