# RAG
MODEL_NAME=mistral
OLLAMA_BASE_URL=http://host.docker.internal:11434
UPLOAD_DIR=temp_uploads
CHROMA_PERSIST_DIR=chroma_db
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Database (valeurs par défaut alignées avec docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/genai

# Mail — Gmail requiert un App Password (https://myaccount.google.com/apppasswords)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# JWT — générer une clé forte : openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
